# Copy to .env.local (gitignored via the *.local rule) and adjust.
#
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret here — everything in this file ships to the client.

# Base URL of the Spring Boot API. Omit to fall back to http://localhost:8181.
# Must be set at BUILD time in deployed environments — Vite inlines it into
# the bundle, so setting it as a runtime env var on the host does nothing.
VITE_API_URL=http://localhost:8181
